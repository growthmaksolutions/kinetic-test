# Copy to .env and fill in. .env is git-ignored — never commit real values.
#
# Create the token in Shopify admin:
#   Settings -> Apps and sales channels -> Develop apps -> Create an app
#   -> Configure Admin API scopes -> enable write_products and read_products
#   -> Install app -> reveal the Admin API access token (starts with shpat_)
#
# This token grants full write access to the store's catalogue. Treat it like
# a password: don't paste it into chat, tickets, or screenshots. Rotate it in
# the same screen if it is ever exposed.

SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Optional — defaults to 2025-07
SHOPIFY_API_VERSION=2025-07
