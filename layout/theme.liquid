<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="theme-color" content="#000000">
    <link rel="canonical" href="{{ canonical_url }}">
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
      <link rel="apple-touch-icon" href="{{ settings.favicon | image_url: width: 180, height: 180 }}">
    {%- else -%}
      <link rel="icon" type="image/webp" href="{{ 'favicon.webp' | asset_url }}">
      <link rel="apple-touch-icon" href="{{ 'favicon.webp' | asset_url }}">
    {%- endif -%}

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
      {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
      {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:wght@600;700;800&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&display=swap" rel="stylesheet">

    <style>
      /* ==========================================================
         KINETIC DESIGN SYSTEM — "Performance Garage"
         Dark, high-contrast, technical. Condensed display type,
         monospace for part data, amber signal accent, sharp edges.
         ========================================================== */
      :root {
        /* --- Canvas & surfaces (warm-neutral near-black) --- */
        --km-body-bg: #0B0B0C;   /* page canvas          */
        --km-surface: #141416;   /* cards, panels        */
        --km-surface-2:        #1C1C1F;   /* raised / hover       */
        --km-surface-3:        #232327;   /* inset wells, inputs  */
        --km-header-bar: #0B0B0C;

        /* --- Ink --- */
        --km-heading: #F4F4F5;   /* headlines            */
        --km-text: #A1A1AA;   /* body copy            */
        --km-text-dim: #71717A;   /* meta, captions       */
        --km-on-dark: #FFFFFF;   /* text over imagery    */
        --km-on-accent: #0B0B0C;   /* text on amber        */

        /* --- Brand --- */
        --km-accent: #FBB03D;   /* signal amber         */
        --km-accent-hot: #FF7A18;   /* hover / gradient end */
        --km-accent-dim: rgba(251,176,61,.14);
        --km-primary: #F4F4F5;   /* primary CTA = light  */
        --km-primary-contrast: #0B0B0C;
        --km-primary-hover: #FFFFFF;

        /* --- Product media plate ---
           The catalogue is photographed on white, so product media sits on a
           deliberate bright plate rather than fighting the dark canvas. Art
           with a baked white background blends into it seamlessly, and cut-out
           art still reads the way it was drawn. Anything placed ON a plate
           must use --km-on-plate, never --km-heading. */
        --km-plate: #FFFFFF;
        --km-plate-2: #F4F4F2;
        --km-plate-border: #E4E4E7;
        --km-on-plate: #0B0B0C;

        /* --- Lines --- */
        --km-border: #26262A;
        --km-border-strong: #3A3A40;
        --km-border-accent: rgba(251,176,61,.38);

        /* --- Signal --- */
        --km-success: #34D399;
        --km-success-bg: rgba(52,211,153,.12);
        --km-warn: #FBBF24;
        --km-danger: #F87171;
        --km-danger-bg: rgba(248,113,113,.12);
        --km-sale: rgba(248,113,113,.16);

        /* --- Geometry: sharp, machined --- */
        --km-radius-sm:        2px;
        --km-radius: 3px;
        --km-radius-lg: 4px;
        --km-radius-pill: 2px;      /* pills flattened       */
        --km-page-max: 1440px;
        --km-gutter: 32px;
        --km-gutter-sm: 16px;

        /* --- Motion & depth --- */
        --km-transition: 180ms cubic-bezier(.2,.7,.3,1);
        --km-shadow-sm: 0 2px 8px rgba(0,0,0,.4);
        --km-shadow: 0 10px 30px rgba(0,0,0,.55);
        --km-shadow-lg: 0 24px 60px rgba(0,0,0,.65);

        /* --- Type --- */
        --km-font-display: "Barlow Condensed", "Arial Narrow", sans-serif;
        --km-font-body: "Manrope", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        --km-font-heading: "Barlow Condensed", "Arial Narrow", sans-serif;
        --km-font-mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;

        /* Scale runs hotter at the display end: condensed faces read
           optically smaller than the Manrope sizes these replaced. */
        --km-fs-xs: 12px;
        --km-fs-sm: 14px;
        --km-fs-base: 16px;
        --km-fs-lg: 18px;
        --km-fs-xl: 24px;
        --km-fs-2xl: 32px;
        --km-fs-3xl: 44px;
        --km-fs-4xl: 60px;
        --km-fs-5xl: 80px;
        --km-fs-6xl: 104px;
      }

      *, *::before, *::after { box-sizing: border-box; }

      body {
        margin: 0;
        background: var(--km-body-bg);
        color: var(--km-text);
        font-family: var(--km-font-body);
        font-size: 16px;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Condensed uppercase display voice */
      h1, h2, h3, .km-display {
        font-family: var(--km-font-display);
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .01em;
        line-height: .95;
        color: var(--km-heading);
      }

      /* Technical data reads as machine output */
      .km-mono, .km-partno, .km-spec-value {
        font-family: var(--km-font-mono);
        font-variant-numeric: tabular-nums;
        letter-spacing: -.01em;
      }

      a { color: inherit; }
      ::selection { background: var(--km-accent); color: var(--km-on-accent); }

      /* Visible focus ring — the dark canvas hides the UA default */
      :focus-visible {
        outline: 2px solid var(--km-accent);
        outline-offset: 2px;
        border-radius: var(--km-radius-sm);
      }

      /* Dark scrollbars, or the page frames itself in white */
      * { scrollbar-color: var(--km-border-strong) transparent; }
      ::-webkit-scrollbar { width: 10px; height: 10px; }
      ::-webkit-scrollbar-track { background: var(--km-body-bg); }
      ::-webkit-scrollbar-thumb {
        background: var(--km-border-strong);
        border-radius: 0;
        border: 2px solid var(--km-body-bg);
      }
      ::-webkit-scrollbar-thumb:hover { background: var(--km-accent); }

      /* Form controls inherit the dark scheme (date pickers, selects) */
      :root { color-scheme: dark; }
      input, select, textarea, button { font-family: inherit; }

      img { max-width: 100%; }

      #shopify-section-sections--26587897266481__header,
      .shopify-section-group-header-group,
      header-group {
        position: sticky;
        top: 0;
        z-index: 1000;
        background: var(--km-header-bar);
        border-bottom: 1px solid var(--km-border);
      }

      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: .01ms !important;
          animation-iteration-count: 1 !important;
          transition-duration: .01ms !important;
          scroll-behavior: auto !important;
        }
      }
    </style>

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {{ content_for_header }}
  </head>
  <body class="template-{{ template | handle }}">
    <a class="km-visually-hidden" href="#MainContent" style="position:absolute;left:-9999px;">Skip to content</a>

    {% sections 'header-group' %}

    <main id="MainContent" role="main">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    <script src="{{ 'theme.js' | asset_url }}" defer></script>

    {%- if settings.brevo_api_key != blank -%}
    <script>
      document.addEventListener('submit', async function(e) {
        const form = e.target;
        if (form.getAttribute('data-name') !== 'newsletter-cta') return;
        
        e.preventDefault();

        const formWrapper = form.closest('.w-form') || form.parentElement;
        const successMessage = formWrapper.querySelector('.w-form-done');
        const errorMessage = formWrapper.querySelector('.w-form-fail');
        const emailInput = form.querySelector('input[name="email"]');
        
        if (!emailInput) return;
        const email = emailInput.value;

        try {
          const response = await fetch('https://api.brevo.com/v3/contacts', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'api-key': '{{ settings.brevo_api_key }}'
            },
            body: JSON.stringify({
              email: email,
              listIds: [{{ settings.brevo_list_id | default: 1 }}],
              updateEnabled: true
            })
          });

          if (response.ok || response.status === 204) {
            if (successMessage) successMessage.style.display = 'block';
            form.style.display = 'none';
          } else {
            if (errorMessage) errorMessage.style.display = 'block';
          }
        } catch (err) {
          console.error('Brevo Error:', err);
          if (errorMessage) errorMessage.style.display = 'block';
        }
      });
    </script>
    {%- endif -%}
  </body>
</html>
