{%- comment -%}
  ------------------------------------------------------------
  Product Specifications — structured technical data table

  Rows are gathered from three sources, all optional:

    1. Auto rows   — real Shopify data (part no. / SKU, barcode,
                     vendor, type, weight) toggled in the editor.
    2. custom.spec_rows — list.single_line_text_field of "Label|Value".
    3. Section blocks   — merchant-authored Label/Value pairs.

  If none of those produce rows, the existing custom.specifications
  rich-text metafield is rendered as-is, so stores that already wrote
  their specs as an HTML blob keep showing them.
  ------------------------------------------------------------
{%- endcomment -%}

{%- liquid
  assign v = product.selected_or_first_available_variant | default: product.variants.first

  assign auto_count = 0
  if section.settings.show_sku and v.sku != blank
    assign auto_count = auto_count | plus: 1
  endif
  if section.settings.show_barcode and v.barcode != blank
    assign auto_count = auto_count | plus: 1
  endif
  if section.settings.show_vendor and product.vendor != blank
    assign auto_count = auto_count | plus: 1
  endif
  if section.settings.show_type and product.type != blank
    assign auto_count = auto_count | plus: 1
  endif
  if section.settings.show_weight and v.weight > 0
    assign auto_count = auto_count | plus: 1
  endif

  assign mf_rows = product.metafields.custom.spec_rows.value | default: product.metafields.custom.spec_rows
  assign mf_count = 0
  if mf_rows != blank
    assign mf_count = mf_rows.size
  endif

  assign total_rows = auto_count | plus: mf_count | plus: section.blocks.size
  assign blob = product.metafields.custom.specifications.value | default: product.metafields.custom.specifications
-%}

{%- if total_rows > 0 or blob != blank -%}
<section class="km-section km-specs" id="Section-{{ section.id }}">
  <div class="km-container">

    <div class="km-specs__head">
      <span class="km-specs__eyebrow km-mono">{{ section.settings.eyebrow | default: 'Technical data' }}</span>
      <h2 class="km-specs__title">{{ section.settings.heading | default: 'Specifications' }}</h2>
    </div>

    {%- if total_rows > 0 -%}
      <div class="km-specs__grid">
        <dl class="km-specs__table">

          {%- if section.settings.show_sku and v.sku != blank -%}
            <div class="km-specs__row km-specs__row--key">
              <dt class="km-specs__label">{{ section.settings.sku_label | default: 'Part number' }}</dt>
              <dd class="km-specs__value">
                <span class="km-spec-value" data-km-partno>{{ v.sku }}</span>
                <button type="button" class="km-specs__copy" data-km-copy="{{ v.sku | escape }}"
                        aria-label="Copy part number {{ v.sku | escape }}">Copy</button>
              </dd>
            </div>
          {%- endif -%}

          {%- if section.settings.show_barcode and v.barcode != blank -%}
            <div class="km-specs__row">
              <dt class="km-specs__label">Barcode</dt>
              <dd class="km-specs__value"><span class="km-spec-value">{{ v.barcode }}</span></dd>
            </div>
          {%- endif -%}

          {%- if section.settings.show_vendor and product.vendor != blank -%}
            <div class="km-specs__row">
              <dt class="km-specs__label">Manufacturer</dt>
              <dd class="km-specs__value">{{ product.vendor }}</dd>
            </div>
          {%- endif -%}

          {%- if section.settings.show_type and product.type != blank -%}
            <div class="km-specs__row">
              <dt class="km-specs__label">Category</dt>
              <dd class="km-specs__value">{{ product.type }}</dd>
            </div>
          {%- endif -%}

          {%- if section.settings.show_weight and v.weight > 0 -%}
            <div class="km-specs__row">
              <dt class="km-specs__label">Weight</dt>
              <dd class="km-specs__value"><span class="km-spec-value">{{ v.weight | weight_with_unit: v.weight_unit }}</span></dd>
            </div>
          {%- endif -%}

          {%- comment -%} Structured rows from the list metafield {%- endcomment -%}
          {%- if mf_rows != blank -%}
            {%- for row in mf_rows -%}
              {%- assign parts = row | split: '|' -%}
              {%- if parts[0] != blank and parts[1] != blank -%}
                <div class="km-specs__row">
                  <dt class="km-specs__label">{{ parts[0] | strip }}</dt>
                  <dd class="km-specs__value"><span class="km-spec-value">{{ parts[1] | strip }}</span></dd>
                </div>
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}

          {%- comment -%} Merchant-authored rows from the theme editor {%- endcomment -%}
          {%- for block in section.blocks -%}
            {%- if block.type == 'spec' and block.settings.label != blank -%}
              <div class="km-specs__row" {{ block.shopify_attributes }}>
                <dt class="km-specs__label">
                  {{ block.settings.label }}
                  {%- if block.settings.note != blank -%}
                    <span class="km-specs__note" title="{{ block.settings.note | escape }}">?</span>
                  {%- endif -%}
                </dt>
                <dd class="km-specs__value">
                  <span class="km-spec-value">{{ block.settings.value }}</span>
                  {%- if block.settings.unit != blank -%}
                    <span class="km-specs__unit">{{ block.settings.unit }}</span>
                  {%- endif -%}
                </dd>
              </div>
            {%- endif -%}
          {%- endfor -%}

        </dl>
      </div>
    {%- endif -%}

    {%- comment -%}
      Legacy path: stores that authored specs as rich text still render.
      Only shown when no structured rows exist, so data never doubles up.
    {%- endcomment -%}
    {%- if total_rows == 0 and blob != blank -%}
      <div class="km-specs__blob rte">{{ blob }}</div>
    {%- endif -%}

    {%- if section.settings.footnote != blank -%}
      <p class="km-specs__footnote">{{ section.settings.footnote }}</p>
    {%- endif -%}
  </div>
</section>

<style>
  .km-specs__head { margin-bottom: 24px; }
  .km-specs__eyebrow {
    display: block;
    font-size: 11px; font-weight: 700;
    letter-spacing: .18em; text-transform: uppercase;
    color: var(--km-accent);
    margin-bottom: 10px;
  }
  .km-specs__title { font-size: clamp(26px, 3vw, 40px); margin: 0; color: var(--km-heading); }

  /* Grid (not multi-column): rows flow left-to-right in source order, so a
     spec never lands in a different column than its neighbour on reflow. */
  .km-specs__table {
    margin: 0; padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(330px, 1fr));
    border: 1px solid var(--km-border);
    border-radius: var(--km-radius-lg);
    overflow: hidden;
    background: var(--km-surface);
  }
  .km-specs__row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.15fr);
    gap: 16px;
    align-items: baseline;
    padding: 14px 18px;
    /* Hairlines only — zebra banding would checkerboard across two columns */
    border-bottom: 1px solid var(--km-border);
    border-right: 1px solid var(--km-border);
  }
  .km-specs__row--key { border-left: 2px solid var(--km-accent); }

  .km-specs__label {
    margin: 0;
    font-size: 11px; font-weight: 700;
    letter-spacing: .12em; text-transform: uppercase;
    color: var(--km-text-dim);
    display: flex; align-items: center; gap: 6px;
  }
  .km-specs__note {
    display: inline-flex; align-items: center; justify-content: center;
    width: 14px; height: 14px; border-radius: 50%;
    background: var(--km-surface-3); color: var(--km-text-dim);
    font-size: 9px; font-weight: 800; cursor: help;
  }
  .km-specs__value {
    margin: 0;
    font-size: 14px; font-weight: 600;
    color: var(--km-heading);
    display: flex; align-items: center; gap: 8px;
    flex-wrap: wrap;
    overflow-wrap: anywhere;
  }
  .km-specs__unit { font-size: 12px; color: var(--km-text-dim); font-weight: 500; }

  .km-specs__copy {
    background: var(--km-surface-3);
    border: 1px solid var(--km-border);
    border-radius: var(--km-radius-sm);
    color: var(--km-text-dim);
    font-size: 9px; font-weight: 800;
    letter-spacing: .12em; text-transform: uppercase;
    padding: 4px 8px; cursor: pointer;
    transition: color var(--km-transition), border-color var(--km-transition);
  }
  .km-specs__copy:hover { color: var(--km-accent); border-color: var(--km-border-accent); }
  .km-specs__copy.is-copied { color: var(--km-success); border-color: var(--km-success); }

  .km-specs__blob {
    border: 1px solid var(--km-border);
    border-radius: var(--km-radius-lg);
    background: var(--km-surface);
    padding: 22px;
    font-size: 14px;
    color: var(--km-text);
  }
  .km-specs__blob :where(table) { width: 100%; border-collapse: collapse; }
  .km-specs__blob :where(td, th) {
    padding: 10px 12px;
    border-bottom: 1px solid var(--km-border);
    text-align: left;
  }
  .km-specs__blob :where(th) { color: var(--km-heading); font-weight: 700; }
  .km-specs__blob :where(p):first-child { margin-top: 0; }
  .km-specs__blob :where(p):last-child { margin-bottom: 0; }

  .km-specs__footnote { margin: 14px 0 0; font-size: 12px; color: var(--km-text-dim); }

  @media (max-width: 860px) {
    .km-specs__table { grid-template-columns: 1fr; }
    .km-specs__row { grid-template-columns: 1fr; gap: 5px; padding: 13px 16px; }
  }
</style>

<script>
  (function () {
    var root = document.getElementById('Section-{{ section.id }}');
    if (!root) return;
    root.addEventListener('click', function (e) {
      var btn = e.target.closest('[data-km-copy]');
      if (!btn || !navigator.clipboard) return;
      navigator.clipboard.writeText(btn.dataset.kmCopy).then(function () {
        var original = btn.textContent;
        btn.textContent = 'Copied';
        btn.classList.add('is-copied');
        setTimeout(function () {
          btn.textContent = original;
          btn.classList.remove('is-copied');
        }, 1600);
      }).catch(function () { /* clipboard blocked — the number is still selectable */ });
    });
  })();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Product Specs",
  "tag": "section",
  "class": "km-specs-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Technical data" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Specifications" },
    { "type": "header", "content": "Automatic rows" },
    {
      "type": "paragraph",
      "content": "Pulled from real product data. Rows with no value are skipped automatically."
    },
    { "type": "checkbox", "id": "show_sku", "label": "Part number (SKU)", "default": true },
    { "type": "text", "id": "sku_label", "label": "Part number label", "default": "Part number" },
    { "type": "checkbox", "id": "show_barcode", "label": "Barcode", "default": false },
    { "type": "checkbox", "id": "show_vendor", "label": "Manufacturer (vendor)", "default": true },
    { "type": "checkbox", "id": "show_type", "label": "Category (product type)", "default": true },
    { "type": "checkbox", "id": "show_weight", "label": "Weight", "default": true },
    { "type": "header", "content": "Footnote" },
    {
      "type": "textarea",
      "id": "footnote",
      "label": "Footnote",
      "default": "Specifications are for reference. Confirm fitment against your motorcycle before ordering."
    },
    { "type": "header", "content": "Other sources" },
    {
      "type": "paragraph",
      "content": "Additional rows are read from the custom.spec_rows list metafield, formatted Label|Value. If no structured rows exist at all, the custom.specifications rich-text metafield is rendered instead."
    }
  ],
  "blocks": [
    {
      "type": "spec",
      "name": "Spec row",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Material" },
        { "type": "text", "id": "value", "label": "Value", "default": "6061-T6 billet aluminium" },
        { "type": "text", "id": "unit", "label": "Unit", "info": "Optional — shown dimmed after the value" },
        { "type": "text", "id": "note", "label": "Tooltip note", "info": "Optional — shows a ? the rider can hover" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product Specs",
      "blocks": [
        { "type": "spec", "settings": { "label": "Material", "value": "6061-T6 billet aluminium" } },
        { "type": "spec", "settings": { "label": "Finish", "value": "Hard anodised" } },
        { "type": "spec", "settings": { "label": "Hardware", "value": "Stainless, included" } }
      ]
    }
  ]
}
{% endschema %}
